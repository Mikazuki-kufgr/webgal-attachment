{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "types": ["react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "webgal-parser": ["../../../target-webgal-mygo/packages/parser/src/index.ts"],
      "webgal-parser/src/*": ["../../../target-webgal-mygo/packages/parser/src/*"],
      "@webgal/editor-preview-protocol": ["../editor-preview-protocol/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
